# Serveur uniquement. Aucun SMS réel sans accord séparé destinataire/coût.
# Ne pas utiliser NEXT_PUBLIC_ ou EXPO_PUBLIC_. Node ne charge pas ce fichier automatiquement.
SMS_PROVIDER=
ORANGE_SMS_ENABLED=false
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2260000
# Nom de 11 caractères max, uniquement si approuvé par Orange.
ORANGE_SMS_SENDER_NAME=
# Clé serveur aléatoire d'au moins 32 octets ; distincte du secret Orange.
CUSTOMER_OTP_HASH_KEY=
ORANGE_SMS_TIMEOUT_MS=8000
ORANGE_SMS_MAX_RESPONSE_BYTES=32768
CUSTOMER_OTP_IP_MAX=5
