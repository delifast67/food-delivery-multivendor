# Scripts do not load .env automatically. Use: node --env-file-if-exists=.env dist/src/server.js
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/delifast
HOST=127.0.0.1
PORT=4000
DEMO_CITY=Ouagadougou
# Demo-only server fees, integer XOF values in [0, 2147483647]
DELIVERY_FEE_XOF=500
SERVICE_FEE_XOF=200
TAX_XOF=0
# Local in-process limiter
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Explicit local mock only; disabled when PayDunya is enabled or an order has an attempt.
DELIFAST_DEMO_PAYMENTS=false

# SERVER ONLY. Leave disabled: no external payment creation is authorized for this lot.
# Never put these in EXPO_PUBLIC_*, NEXT_PUBLIC_* or versioned configuration.
# No default provider. Only "paydunya" is currently implemented; leave empty.
PAYMENT_PROVIDER=
PAYDUNYA_ENABLED=false
PAYDUNYA_MODE=test
PAYDUNYA_LIVE_AUTHORIZED=false
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=Delifast
# Set controlled HTTPS URLs only after explicit approval; no deployment is performed here.
# Callback path: /payments/paydunya/ipn
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_RETURN_URL=
PAYDUNYA_CANCEL_URL=

# Serveur uniquement. Aucun SMS réel sans accord séparé destinataire/coût.
# Ne pas utiliser NEXT_PUBLIC_ ou EXPO_PUBLIC_. Node ne charge pas ce fichier automatiquement.
SMS_PROVIDER=
ORANGE_SMS_ENABLED=false
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SMS_SENDER_ADDRESS=tel:+2260000
# Nom de 11 caractères max, uniquement si approuvé par Orange.
ORANGE_SMS_SENDER_NAME=
# Clé serveur aléatoire d'au moins 32 octets ; distincte du secret Orange.
CUSTOMER_OTP_HASH_KEY=
ORANGE_SMS_TIMEOUT_MS=8000
ORANGE_SMS_MAX_RESPONSE_BYTES=32768
CUSTOMER_OTP_IP_MAX=5
