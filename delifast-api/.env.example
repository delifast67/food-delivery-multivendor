# Scripts do not load .env automatically. Use: node --env-file-if-exists=.env dist/src/server.js
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/delifast
HOST=127.0.0.1
PORT=4000
DEMO_CITY=Ouagadougou
# Demo-only server fees, integer XOF values in [0, 2147483647]
DELIVERY_FEE_XOF=500
SERVICE_FEE_XOF=200
TAX_XOF=0
# Local in-process limiter
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
