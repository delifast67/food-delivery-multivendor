# Exemple uniquement : aucune autorisation d’envoi et aucun secret.
# À injecter dans l’environnement serveur après autorisation explicite.
# Ce fichier n’est pas chargé automatiquement par l’API.
D7_VERIFY_ENABLED=false
D7_API_TOKEN=
D7_VERIFY_ORIGINATOR=D7VERIFY
D7_VERIFY_TEMPLATE_ID=
D7_VERIFY_CONTENT={}
D7_VERIFY_TIMEOUT_MS=8000
D7_VERIFY_MAX_RESPONSE_BYTES=32768
CUSTOMER_OTP_IP_MAX=5
