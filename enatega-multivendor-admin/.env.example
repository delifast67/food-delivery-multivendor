# Démo Delifast locale uniquement. Copier vers .env avant de démarrer ou compiler.
DELIFAST_LOCAL_MODE=true
# URL serveur uniquement, sans identifiants ni tokens.
DELIFAST_API_URL=http://127.0.0.1:4000/graphql
# Désactive la télémétrie de Next ; ne constitue pas un pare-feu réseau.
NEXT_TELEMETRY_DISABLED=1
