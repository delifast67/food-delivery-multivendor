# Démo Delifast locale uniquement. Copier vers .env, jamais versionner les valeurs privées.
# Vide : localhost sur iOS, 10.0.2.2 sur l'émulateur Android (port 4000).
# Sur téléphone physique, utiliser explicitement l'adresse LAN de la machine de développement.
EXPO_PUBLIC_DELIFAST_API_URL=
# Toute variable EXPO_PUBLIC_* est publique dans le bundle : aucun secret serveur ici.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_REVERSED_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
